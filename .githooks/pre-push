#!/bin/sh
# Before anything leaves this machine, check every commit being pushed.
ROOT="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
status=0
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    if git rev-parse -q --verify origin/main >/dev/null 2>&1; then range="origin/main..$local_sha"; else range="$local_sha"; fi
  else
    range="$remote_sha..$local_sha"
  fi
  sh "$ROOT/tools/check-authors.sh" "$range" >/dev/null || {
    echo "Push blocked. These commits break the authorship rule:"
    sh "$ROOT/tools/check-authors.sh" "$range"
    status=1
  }
done
exit $status
